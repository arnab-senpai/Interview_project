  "layers": [
    {
      "layer": 1,
      "shortName": "EDGE & DNS",
      "title": "Layer 1 · Edge, DNS & Transport",
      "description": "How requests cross the public internet before hitting your datacenter."
    },
    {
      "layer": 2,
      "shortName": "GATEWAY & LB",
      "title": "Layer 2 · Traffic Control & Gateways",
      "description": "Routing, TLS termination, load distribution, auth, and rate limiting."
    },
    {
      "layer": 3,
      "shortName": "CACHE & MEM",
      "title": "Layer 3 · Caching & Probabilistic Structures",
      "description": "Keeping hot reads in RAM and defending origin databases against thundering herds."
    },
    {
      "layer": 4,
      "shortName": "STORAGE",
      "title": "Layer 4 · Storage Engines & Specialized Databases",
      "description": "Choosing B-Trees vs LSM-Trees, SQL vs NoSQL, sharding, geospatial, and vector indices."
    },
    {
      "layer": 5,
      "shortName": "CONSENSUS",
      "title": "Layer 5 · Distributed Coordination & Consensus",
      "description": "CAP/PACELC trade-offs, replication, consistent hashing, Raft/Paxos, and distributed locks."
    },
    {
      "layer": 6,
      "shortName": "ASYNC",
      "title": "Layer 6 · Asynchronous Messaging & Streaming",
      "description": "Decoupling writes with queues, event logs, consumer groups, DLQs, and Sagas."
    },
    {
      "layer": 7,
      "shortName": "RESILIENCE & AI",
      "title": "Layer 7 · Resilience, Observability & Modern AI Infra",
      "description": "Idempotency, circuit breakers, telemetry, RAG pipelines, and GPU inference serving."
    }
  ],
